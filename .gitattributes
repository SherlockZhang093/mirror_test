# Unity text assets
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.md text eol=lf
# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary
*.mov binary
*.mp4 binary
*.fbx filter=lfs diff=lfs merge=lfs -text
*.ttf binary
*.otf binary
*.glb filter=lfs diff=lfs merge=lfs -text
